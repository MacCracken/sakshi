# syscalls.cyr — sakshi's minimal, arch-dispatched Linux syscall numbers.
#
# Sakshi cannot pull `lib/syscalls.cyr` from the cyrius stdlib because the
# foundation-layer rule forbids external deps and that file's enum surface
# (~60+ values per arch) is too large to inline through the bundle. Instead
# we define just the syscalls sakshi actually uses.
#
# Numbers: x86_64 from `arch/x86/entry/syscalls/syscall_64.tbl`;
# aarch64 from `include/uapi/asm-generic/unistd.h`.
#
# v2.2.2 — closes the cross-build syscall-arity warnings reported on
# `cyrius build --aarch64`. Pre-v2.2.2 the numbers were inlined as bare
# integers, so the aarch64 binary called the wrong syscall (silent UB).
#
# They are `const` since 2.5.8 (cyrius 6.7.2+). A const has no storage: every
# use folds to its value exactly as a literal does, so `syscall(_SK_SYS_X, ..)`
# compiles to the same code as `syscall(N, ..)` on every target. That matters
# because cyrius's macOS `__got` libcall reroutes and its Windows IAT reroutes
# match the syscall NUMBER at compile time. Until 2.5.8 these were `var`
# slots, which do not fold, so those reroutes never saw them (cyrius issue
# 2026-06-16-var-syscall-number-defeats-macho-pe-reroute). The var slots kept
# working only through the run-time paths: the ESYSXLAT renumbering on aarch64
# and on both macOS backends, and on Windows the run-time dispatch cyrius
# 6.1.16 added for a non-literal number. clock_gettime / nanosleep / QPC need the compile-time
# reroutes, so clock.cyr spelled them as bare literals; they are named below
# now. ⚠ Keep every syscall number a `const` (or a literal): turning one back
# into a `var` silently loses the compile-time reroute again.
#
# AGNOS (ring-3) is x86_64 but NOT Linux: its syscall numbers and `open` ABI
# differ, and `CYRIUS_ARCH_X86` is predefined on every x86 build (agnos
# included), so the agnos branch must come FIRST and the Linux branches must be
# excluded under it — otherwise agnos silently took the Linux numbers (open #2,
# close #3, exit #60 → agnos getpid/spawn/undefined) and corrupted every log.
# agnos has no BSD sockets (socket/sendto), so UDP transport is unavailable here
# (output.cyr returns -1 → caller keeps stderr).
#ifdef CYRIUS_TARGET_AGNOS
const _SK_SYS_WRITE         = 1;
const _SK_SYS_OPEN          = 7;
const _SK_SYS_CLOSE         = 6;
const _SK_SYS_EXIT          = 0;
# The reference clock (clock.cyr _sk_clock_now_ns_raw): uptime_us first,
# uptime_ms only when it answers -1. agnos has no reroute for either. ⚠ 95 is
# Linux `umask`, so these must stay inside the CYRIUS_TARGET_AGNOS guard.
const _SK_SYS_UPTIME_US     = 95;
const _SK_SYS_UPTIME_MS     = 40;
#endif

#ifndef CYRIUS_TARGET_AGNOS
#ifdef CYRIUS_ARCH_X86
const _SK_SYS_WRITE         = 1;
const _SK_SYS_OPEN          = 2;
const _SK_SYS_CLOSE         = 3;
const _SK_SYS_SOCKET        = 41;
const _SK_SYS_SENDTO        = 44;
const _SK_SYS_EXIT          = 60;
# nanosleep: the calibration window in clock.cyr _sk_clock_init (x86 only).
# Routed to Sleep on Windows and to poll on x86 macOS.
const _SK_SYS_NANOSLEEP     = 35;
#endif

#ifdef CYRIUS_ARCH_AARCH64
# aarch64 has no `open` — use `openat(AT_FDCWD, path, flags, mode)`.
const _SK_SYS_OPENAT        = 56;
const _SK_SYS_CLOSE         = 57;
const _SK_SYS_WRITE         = 64;
const _SK_SYS_EXIT          = 93;
const _SK_SYS_SOCKET        = 198;
const _SK_SYS_SENDTO        = 206;
const _SK_AT_FDCWD          = 0 - 100;
#endif

# clock_gettime: the reference clock in clock.cyr _sk_clock_now_ns_raw, on every
# target but AGNOS. ⚠ The x86_64 number on EVERY arch, aarch64 included:
# cyrius's aarch64 ESYSXLAT translates 228 → 113 (the native number), macOS
# reroutes it to _clock_gettime_nsec_np on both Darwin backends, and Windows to
# GetTickCount64 (the fallback when QueryPerformanceFrequency fails).
const _SK_SYS_CLOCK_GETTIME = 228;
#endif

#ifdef CYRIUS_TARGET_WIN
# kernel32 QueryPerformanceCounter / QueryPerformanceFrequency, routed since
# cyrius 6.6.5. Each writes a 64-bit count at its argument and returns a BOOL.
const _SK_SYS_QPC           = 0xF038;
const _SK_SYS_QPF           = 0xF039;
#endif

# open(path, flags, mode) — arity-stable wrapper. x86_64 Linux calls `open`;
# aarch64 calls `openat(AT_FDCWD, path, flags, mode)`; agnos `open` is
# (name, namelen, flags) with AO_* bits (differ from Linux O_*), so compute the
# byte length and remap the flags (mirrors lib/io.cyr file_open). Returns fd or
# negative errno.
fn _sk_open(path, flags, mode): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    var n = 0;
    while (load8(path + n) != 0) { n = n + 1; }
    var ao = 0;
    ao = ao | (flags & 3);   # O_/AO_ access mode 1:1 (0/1/2); was folding O_RDWR→AO_WRONLY
    if ((flags & 64) != 0) { ao = ao | 0x100; }     # O_CREAT  -> AO_CREAT
    if ((flags & 512) != 0) { ao = ao | 0x200; }    # O_TRUNC  -> AO_TRUNC
    if ((flags & 1024) != 0) { ao = ao | 0x400; }   # O_APPEND -> AO_APPEND
    return syscall(_SK_SYS_OPEN, path, n, ao);
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    #ifdef CYRIUS_ARCH_X86
    return syscall(_SK_SYS_OPEN, path, flags, mode);
    #endif
    #ifdef CYRIUS_ARCH_AARCH64
    return syscall(_SK_SYS_OPENAT, _SK_AT_FDCWD, path, flags, mode);
    #endif
    #endif
}
