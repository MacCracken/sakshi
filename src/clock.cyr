# clock.cyr — cycle-counter timestamps for sakshi
#
# Reads the host's cycle counter directly without going through the kernel:
# x86_64: `rdtsc`. aarch64: `mrs cntvct_el0` (added in step 5).
#
# Public-internal API:
#   _sk_now_ticks()        → i64    raw cycle counter
#   _sk_clock_init()       → i64    invariant-TSC check + freq calibration + anchor
#   _sk_ticks_to_ns(ticks) → i64    counter reading → ns on the reference clock's timeline
#   _sk_now_ns()           → i64    drop-in replacement for the syscall version (step 4)
#
# Calibration policy: invariant-TSC required on x86_64. Non-invariant hosts
# panic at init — sakshi targets sovereign systems on real hardware, no soft
# fallback to clock_gettime.
#
# Inline asm follows the local-store pattern (writes only to [rbp-N] / [x29-N])
# to stay clear of the cyrius include-boundary store bug.

# Calibrated TSC frequency (Hz). Zero until _sk_clock_init() runs.
var _sk_tsc_freq_hz: i64 = 0;

# Q32 fixed-point ns-per-tick scale (set in step 3).
var _sk_tsc_scale: i64 = 0;

# Set once _sk_clock_init has RUN, whether or not it managed to calibrate.
# Distinct from _sk_tsc_freq_hz on purpose: init used to gate on the frequency
# being non-zero while _sk_now_ns gated on the SCALE being non-zero, so a host
# where calibration failed left both at 0 and every single _sk_now_ns re-entered
# the full 10 ms nanosleep window. One flag, one meaning: "we already tried".
var _sk_clock_init_done: i64 = 0;

# Anchor of the tick → ns conversion (2.5.4), folded into one offset.
# _sk_clock_install anchors the conversion at a reference-clock reading ns0
# (_sk_clock_now_ns_raw) taken when the cycle counter read tsc0, so a timestamp
# is "the reference clock at calibration, plus counter time since":
#
#   ns(t) = ns0 + ((t - tsc0) * scale >> 32)
#
# stored pre-folded, so the hot path pays ONE add over the unanchored conversion:
#
#   _sk_tsc_offset = ns0 - (tsc0 * scale >> 32)
#   ns(t)          = (t * scale >> 32) + _sk_tsc_offset       (within 1 ns of the above)
#
# One interleaved session, 5 rounds each: `timestamp` 21.94 ns on 2.5.3,
# 21.92 ns folded, 22.64 ns unfolded. The product stays an absolute, unsigned
# counter reading, so a read slightly BEFORE tsc0 (a core whose TSC trails the
# anchoring core's) needs no signed arithmetic — the unfolded form's delta would
# have gone negative.
#
# Until 2.5.4 the offset was implicitly 0: counter time since the COUNTER's
# origin, i.e. the host's uptime, while every process calibrates its own scale
# over one short window. So each process's calibration error was multiplied by
# the whole uptime, and two processes on one host disagreed by seconds:
# back-to-back runs appending one line each to the same log printed timestamps
# +7.0 s, -5.2 s, +0.95 s apart at ~35 h uptime (x86_64 Linux), and hundreds to
# thousands of seconds apart under wine. Anchored, the error grows only with the
# time since THIS process calibrated, and every process lands on the one
# timeline they share — the reference clock's, which is also exactly what the
# calibration-failure fallback in _sk_now_ns returns.
var _sk_tsc_offset: i64 = 0;

# Read the cycle counter. Returns raw ticks; convert with _sk_ticks_to_ns.
fn _sk_now_ticks(): i64 {
    var ticks: i64 = 0;
    #ifdef CYRIUS_ARCH_X86
    asm {
        # Frame: [rbp-8]=ticks
        # rdtsc puts the 64-bit counter in edx:eax. Combine into rax.
        0x0F; 0x31;                    # rdtsc
        0x48; 0xC1; 0xE2; 0x20;        # shl rdx, 32
        0x48; 0x09; 0xD0;              # or rax, rdx
        0x48; 0x89; 0x45; 0xF8;        # mov [rbp-8], rax  ; ticks
    }
    #endif
    #ifdef CYRIUS_ARCH_AARCH64
    asm {
        # Frame: [x29-8]=ticks
        # CNTVCT_EL0 is architectural in ARMv8.0-A — no feature check needed.
        0x40; 0xE0; 0x3B; 0xD5;        # mrs x0, cntvct_el0
        0xA0; 0x83; 0x1F; 0xF8;        # stur x0, [x29, #-8]
    }
    #endif
    return ticks;
}

# aarch64 only: read CNTFRQ_EL0 (timer frequency in Hz). Architectural —
# no calibration required.
fn _sk_aarch64_cntfrq(): i64 {
    var freq: i64 = 0;
    #ifdef CYRIUS_ARCH_AARCH64
    asm {
        # Frame: [x29-8]=freq
        0x00; 0xE0; 0x3B; 0xD5;        # mrs x0, cntfrq_el0
        0xA0; 0x83; 0x1F; 0xF8;        # stur x0, [x29, #-8]
    }
    #endif
    return freq;
}

# CPUID(0x80000007) EDX bit 8 — invariant TSC. Returns 1 if supported, 0 if not.
fn _sk_cpuid_invariant_tsc(): i64 {
    var result: i64 = 0;
    #ifdef CYRIUS_ARCH_X86
    asm {
        # Frame: [rbp-8]=result
        # cpuid clobbers rax/rbx/rcx/rdx. rbx is callee-saved in the SysV ABI;
        # save it across the cpuid call so the cyrius compiler's caller-side
        # invariants hold.
        0xB8; 0x07; 0x00; 0x00; 0x80;  # mov eax, 0x80000007
        0x53;                          # push rbx
        0x0F; 0xA2;                    # cpuid
        0x5B;                          # pop rbx
        0x48; 0xC1; 0xEA; 0x08;        # shr rdx, 8
        0x48; 0x83; 0xE2; 0x01;        # and rdx, 1
        0x48; 0x89; 0x55; 0xF8;        # mov [rbp-8], rdx
    }
    #endif
    return result;
}

# Write to fd 2 and exit. Used for the invariant-TSC-absent panic.
fn _sk_clock_panic(msg, len): i64 {
    syscall(_SK_SYS_WRITE, 2, msg, len);
    syscall(_SK_SYS_EXIT, 1);
    return 0;
}

# QueryPerformanceFrequency, read once by the Windows branch below: 0 = unread,
# < 0 = the query failed and GetTickCount64 stands in.
var _sk_qpf_hz: i64 = 0;

# Monotonic reference clock. NOT calibration-only, despite what this comment
# said before 2.5.0: it is the entire clock on AGNOS (which skips the TSC),
# since 2.5.0 it is also the fallback _sk_now_ns uses on any target whose
# calibration failed, and since 2.5.4 it is the timeline every timestamp is
# anchored to. Per-target contract differs — Linux fills the timespec, macOS
# returns the value in the return register, Windows fills a 64-bit count — so
# read the branches below before adding a caller.
fn _sk_clock_now_ns_raw(): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    # agnos: uptime_us (#95) FIRST, uptime_ms (#40) only as a fallback.
    #
    # #40 was the sole source here until 2.5.1, and it is the WRONG one for a
    # library. AGNOS's own userland ABI (docs/development/agnos-userland-abi.md,
    # row 95) is explicit: a foreground `run` program starts with IF cleared —
    # only /bin/agnsh gets IF=1 — so the 100 Hz timer ISR never fires and #40 is
    # FROZEN for that program's entire duration. sakshi is linked into exactly
    # such programs, so every event carried an identical timestamp and every
    # sakshi_span_exit computed elapsed = 0. The AGNOS note records that this
    # cost two iron burns on the 3D arc before it was understood.
    #
    # #95 is rdtsc-backed and calibrated at boot against the live tick, so it
    # needs no interrupts, and it is microsecond rather than 10 ms granular.
    # It returns -1 (never a plausible 0) when calibration was refused, which is
    # what makes the fallback below safe to distinguish.
    #
    # Both numbers MUST be literals — a `var` does not const-fold, and agnos has
    # no reroute for either. ⚠ #95 collides with Linux `umask`, so this must stay
    # inside the CYRIUS_TARGET_AGNOS guard; that ifdef is the only barrier.
    var us = syscall(95);
    if (us >= 0) { return us * 1000; }
    var ms = syscall(40);
    if (ms < 0) { return 0; }
    return ms * 1000000;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    var ts[16];   # {tv_sec,tv_nsec} = 16 B (var[N] byte-sized; [2] would OOB the +8 store).
    # The syscall NUMBER 228 MUST be a literal — a `var`/named constant does not
    # const-fold, so the macOS __got reroute and the Windows IAT reroute never fire
    # and a raw bad syscall results (returned -9 / garbage). cyrius issue 2026-06-16.
    # Reached from calibration and the anchor sample (every target but AGNOS; on
    # aarch64 only the anchor), and from _sk_now_ns's calibration-failure fallback.
    #ifdef CYRIUS_TARGET_WIN
    # Windows: QueryPerformanceCounter (syscall 0xF038 = 61496), scaled by
    # QueryPerformanceFrequency (0xF039 = 61497), both routed since cyrius 6.6.5 and
    # both literals for the same reason 228 is. Each writes a 64-bit count at &ts
    # and returns a BOOL; a failed read leaves the pre-zeroed 0, which every caller
    # already treats as "no reading".
    #
    # Until 2.5.4 this was GetTickCount64 (228, ms in the return register), the only
    # monotonic reroute PE had before 6.6.5. It moves in ~16 ms steps — measured
    # under wine: +16 or +17 ms every 16.1-16.5 ms — which is LONGER than the 10 ms
    # calibration window, so the first window to see dn > 0 saw one whole step
    # against ~10 ms of TSC. Every PE process calibrated its 3194 MHz TSC at
    # 1894-2017 MHz, ~37% low, and every PE timestamp and span ran ~1.6x fast.
    # QPC ticks at 10 MHz (100 ns) under wine and on current Windows.
    #
    # The conversion is split so it cannot overflow (as lib/chrono.cyr's
    # _chrono_qpc_ns): count * 1e9 would wrap i64 after ~29 years at 10 MHz. A
    # frequency query that fails — impossible on any supported Windows — keeps
    # GetTickCount64 rather than leaving no clock: coarse beats wrong-scaled.
    # Spelled raw rather than as lib/syscalls_windows.cyr's sys_qpc_ns for the
    # reason chrono.cyr gives: the dist bundle must keep building for PE in a
    # consumer whose [deps] stdlib does not list "syscalls".
    if (_sk_qpf_hz == 0) {
        store64(&ts, 0);
        syscall(61497, &ts);
        _sk_qpf_hz = load64(&ts);
        if (_sk_qpf_hz == 0) { _sk_qpf_hz = 0 - 1; }
    }
    if (_sk_qpf_hz < 0) { return syscall(228, 4, &ts) * 1000000; }
    store64(&ts, 0);
    syscall(61496, &ts);
    var qc = load64(&ts);
    return (qc / _sk_qpf_hz) * 1000000000 + ((qc % _sk_qpf_hz) * 1000000000) / _sk_qpf_hz;
    #endif
    #ifndef CYRIUS_TARGET_WIN
    #ifdef CYRIUS_TARGET_MACOS
    # macOS returns the answer in the RETURN REGISTER, not through the buffer.
    # 228 IS rerouted on both Darwin backends — EMACHO_CLOCK_ARM sends it to
    # libSystem _clock_gettime_nsec_np(CLOCK_MONOTONIC_RAW=4) via __got[6] on
    # arm64, EMACHO_CLOCK_X86 composes ns on x86_64 — and both hand back u64
    # nanoseconds directly. cyrius's own _prof_clock_ns
    # (src/backend/common/runtime.cyr) consumes it exactly this way:
    # `return syscall(228, 4, &ts);` for macOS, and the timespec decode below
    # only for Linux.
    #
    # This branch did not exist until 2.5.0, so macOS fell through to the Linux
    # decode and read `load64(&ts)*1e9 + load64(&ts+8)` out of a buffer the
    # reroute never filled as a timespec — a garbage calibration anchor, and
    # therefore a garbage TSC frequency and every span duration wrong.
    #
    # The buffer must still be a REAL address even though the answer does not
    # come through it: EMACHO_CLOCK_X86 dereferences the third argument
    # (`mov rax,[rdi]`), and cyrius v6.5.43 SIGSEGV'd on Intel Mac for passing
    # a literal 0 there.
    var mret = syscall(228, 4, &ts);
    if (mret < 0) { return 0; }
    return mret;
    #endif
    #ifndef CYRIUS_TARGET_MACOS
    # Linux: clock_gettime(MONOTONIC_RAW=4) fills the timespec.
    var ret = syscall(228, 4, &ts);
    if (ret < 0) { return 0; }
    return load64(&ts) * 1000000000 + load64(&ts + 8);
    #endif
    #endif
    #endif
}

enum _SkClockConst {
    # Tries per _sk_clock_sample. Measured on x86_64 Linux, 40 cold starts per
    # setting, calibrated frequency against a 1 s reference window: ONE bracket
    # is worse than none (+124 ppm mean, 111 ppm sd — the first read after a
    # sleep is slow and lopsided); three or more are unbiased (+1 ppm mean,
    # 24 ppm sd) and more buy nothing. 5 leaves room for two preempted reads.
    _SK_SAMPLE_TRIES = 5;
}

# Read the reference clock and the cycle counter "at the same moment", into
# *out_ticks / *out_ns. Each try brackets one reference read between two counter
# reads and credits it to their midpoint; the tightest bracket wins, which
# rejects a read that was preempted or ran long. A failed read (<= 0) never
# wins, so *out_ns stays 0 only if every try failed.
#
# Both ends of the calibration window use this, symmetrically. Until 2.5.4 the
# window opened reference-then-counter and closed counter-then-reference, so
# each end was skewed by the part of a syscall on its side — the same way, never
# cancelling — and dn came out about one syscall (~2.5 us here, cold after the
# sleep) longer than dt over the 10 ms: the frequency read -246 ppm low (23 ppm
# sd, 40 of 40 cold starts below true). Anchored, that bias is the rate at which
# a process's timestamps drift off the reference — ~0.9 s per hour.
fn _sk_clock_sample(out_ticks, out_ns): i64 {
    var best = 0x7FFFFFFFFFFFFFFF;
    store64(out_ticks, 0);
    store64(out_ns, 0);
    var i = 0;
    while (i < _SK_SAMPLE_TRIES) {
        var ta = _sk_now_ticks();
        var ns = _sk_clock_now_ns_raw();
        var tb = _sk_now_ticks();
        if (ns > 0 && tb - ta < best) {
            best = tb - ta;
            store64(out_ticks, ta + (tb - ta) / 2);
            store64(out_ns, ns);
        }
        i = i + 1;
    }
    return 0;
}

# One-shot init: panic if invariant TSC is absent, then calibrate freq with
# a 10 ms nanosleep window. Stores _sk_tsc_freq_hz, then installs _sk_tsc_scale
# and the anchor pair together through _sk_clock_install.
# Idempotent — early-returns if already initialized.
fn _sk_clock_init(): i64 {
    if (_sk_clock_init_done != 0) { return 0; }
    _sk_clock_init_done = 1;

    #ifdef CYRIUS_TARGET_AGNOS
    # agnos uses uptime_ms directly (see _sk_now_ns) — no TSC calibration: no
    # cpuid invariant-TSC check, no nanosleep window. (The 100 Hz uptime_ms tick
    # is far too coarse to calibrate a GHz TSC over a short window, and #35
    # (nanosleep) is agnos `sysinfo`, not sleep.) Set nonzero sentinels so the
    # idempotent guard + any `_sk_tsc_scale == 0` check are satisfied.
    _sk_tsc_freq_hz = 1;
    _sk_tsc_scale = 1;
    _sk_clock_init_done = 1;
    return 0;
    #endif

    #ifndef CYRIUS_TARGET_AGNOS
    # The anchor: one reference-clock reading and the counter value at that
    # moment. Each arch arm below fills it; _sk_clock_install commits it.
    var anchor_ticks = 0;
    var anchor_ns = 0;

    #ifdef CYRIUS_ARCH_X86
    if (_sk_cpuid_invariant_tsc() == 0) {
        _sk_clock_panic("sakshi: clock_init: invariant TSC absent (CPUID 0x80000007 EDX bit 8 = 0)\n", 75);
    }

    # nanosleep(10 ms). timespec is { tv_sec, tv_nsec } — two i64 = 16 bytes.
    # var[N] is byte-sized in cyrius, so this must be [16], not [2]: a [2]
    # reserves only 8 bytes and the tv_nsec store at +8 would land in the
    # next stack local.
    #
    # Portable across Linux and Windows PE: the cyrius ≥ 6.1.17 pin routes
    # nanosleep(35) to Sleep on PE. Earlier runtimes returned -ENOSYS on PE,
    # which forced a now-removed clock_gettime busy-spin window here (and the
    # GetTickCount64 fallback in _sk_now_ns) — both retired in v2.2.10.
    # The number 35 MUST be a literal — a `var` does not const-fold, so the PE
    # reroute (and the macOS reroute) never fires (cyrius issue 2026-06-16). The
    # old `_SK_SYS_NANOSLEEP` var silently defeated exactly the PE routing this
    # comment relies on.
    var sleep_ts[16];
    store64(&sleep_ts, 0);
    store64(&sleep_ts + 8, 10000000);

    # RETRY the window rather than measuring once. The reference clock is not
    # always fine-grained enough to resolve 10 ms: on Windows PE
    # _sk_clock_now_ns_raw was GetTickCount64 until 2.5.4 (and still is if
    # QueryPerformanceFrequency fails), whose tick is ~15.6 ms, so both
    # ends of a single 10 ms window routinely land inside ONE tick. That gives
    # dn == 0, no frequency, no scale — and _sk_ticks_to_ns then multiplies by a
    # zero scale, so EVERY timestamp is 0. Observed deterministically: the PE
    # smoke printed `[0] [INFO] sakshi smoke ok` on 5 of 5 cold runs.
    # Each retry adds another 10 ms of separation, so a coarse tick is crossed
    # within a couple of attempts. Bounded so a genuinely dead reference clock
    # costs a fixed 80 ms once, not an unbounded stall.
    # freq_hz = dt * 1e9 / dn. At 3 GHz, dt ≈ 3e7 over 10 ms, so dt*1e9 ≈ 3e16
    # — well inside i64 (max ≈ 9.2e18).
    var attempts = 0;
    while (attempts < 8) {
        var k0 = 0;
        var n0 = 0;
        _sk_clock_sample(&k0, &n0);
        syscall(35, &sleep_ts, 0);
        # The window's closing sample doubles as the anchor.
        _sk_clock_sample(&anchor_ticks, &anchor_ns);
        var dn = anchor_ns - n0;
        var dt = anchor_ticks - k0;
        if (n0 > 0 && dn > 0 && dt > 0) {
            _sk_tsc_freq_hz = dt * 1000000000 / dn;
            break;
        }
        attempts = attempts + 1;
    }
    #endif

    #ifdef CYRIUS_ARCH_AARCH64
    # CNTFRQ_EL0 is architectural — read directly, no calibration needed.
    _sk_tsc_freq_hz = _sk_aarch64_cntfrq();
    # No window to borrow a sample from, so take one — the only reference reads
    # aarch64 init makes (clock_gettime, translated 228 → 113).
    _sk_clock_sample(&anchor_ticks, &anchor_ns);
    #endif

    # Q32 ns-per-tick scale: scale = (1e9 << 32) / freq.
    # 1e9 << 32 = 4.29e18 — fits in i64 (max ≈ 9.22e18).
    # For 3 GHz, scale ≈ 1.43e9 (fits in u32). _sk_ticks_to_ns recovers ns
    # via 64×64→128 mul + 32-bit shrd, accurate to <1 ppm across the full
    # u64 tick range.
    if (_sk_tsc_freq_hz > 0) {
        _sk_clock_install((1000000000 << 32) / _sk_tsc_freq_hz, anchor_ticks, anchor_ns);
    }
    return 0;
    #endif
}

# Install a calibration: the Q32 scale and its anchor pair, together. Also the
# one place sakshi_clock_recalibrate's "never steps back" guarantee is kept.
#
# Re-anchoring snaps the clock back onto the reference — but a clock that ran
# FAST since its last calibration is AHEAD of the reference, and snapping it back
# would hand out a timestamp earlier than one already handed out, and give a span
# straddling the recalibration a negative elapsed. So the new conversion starts,
# at the new anchor tick, from whichever is later: the reference reading, or the
# old conversion's value there. A clock that ran slow steps forward onto the
# reference; one that ran fast holds its lead instead of going back, and the new
# scale stops that lead from growing. First init has no old conversion
# (_sk_tsc_scale == 0 — also the state a failed calibration leaves) and anchors
# on the reference outright.
#
# `ns <= 0` means the reference read failed. x86 cannot get here that way — its
# window needs dn > 0 to produce a frequency at all — so this is aarch64: count
# from the counter's own origin (offset 0), as before 2.5.4. That is still
# identical in every process on the host, because CNTFRQ_EL0 is architectural
# and is not calibrated per process.
fn _sk_clock_install(scale, ticks, ns): i64 {
    var old_scale = _sk_tsc_scale;
    var held: i64 = 0;
    if (old_scale != 0) { held = _sk_ticks_to_ns(ticks); }
    _sk_tsc_scale = scale;
    _sk_tsc_offset = 0;
    var at = _sk_ticks_to_ns(ticks);
    if (ns > 0) {
        _sk_tsc_offset = ns - at;
        at = ns;
    }
    if (old_scale != 0) {
        if (held > at) { _sk_tsc_offset = _sk_tsc_offset + (held - at); }
    }
    return 0;
}

# Monotonic nanoseconds — drop-in replacement for the v2.1.x clock_gettime
# implementation. Lazy first-call init; subsequent calls are rdtsc + mul-shift,
# no syscall. Since 2.5.4 the value is on the reference clock's timeline
# (_sk_clock_now_ns_raw — MONOTONIC_RAW on Linux, as in v2.1.x), anchored at
# calibration; the counter supplies only the time since the anchor. 2.2.0-2.5.3
# counted from the counter's own origin instead — see _sk_tsc_offset for why that
# made two processes' timestamps incomparable.
fn _sk_now_ns(): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    # agnos: skip the rdtsc TSC fast-path entirely. uptime_ms (#40) is ~10 ms-
    # granular at the 100 Hz tick, so calibrating a GHz TSC against a short
    # window would yield a ~±100% garbage frequency. Read uptime_ms directly —
    # coarse but correct; mirrors chrono.cyr's agnos clock. All span/output
    # capture flows through here, so this covers every consumer time-stamp.
    return _sk_clock_now_ns_raw();
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    if (_sk_clock_init_done == 0) {
        _sk_clock_init();
    }
    # Calibration can still come back empty on a host whose reference clock is
    # too coarse to measure the window even after the retries in
    # _sk_clock_init. Fall back to that reference clock directly: coarse, but
    # monotonic and non-zero. A zero timestamp on every event is strictly worse
    # than a low-resolution one, and gating on _sk_clock_init_done (not on the
    # scale) is what stops this from re-entering the 10 ms window every call.
    if (_sk_tsc_scale == 0) {
        return _sk_clock_now_ns_raw();
    }
    return _sk_ticks_to_ns(_sk_now_ticks());
    #endif
}

# Re-run the calibration loop and refresh _sk_tsc_freq_hz / _sk_tsc_scale.
# Useful for long-running consumers (uptime > ~1 hour) where the TSC's true
# rate has drifted relative to the kernel's MONOTONIC_RAW. Returns the new freq
# in Hz.
#
# Since 2.5.4 it also RE-ANCHORS: the clock's accumulated offset from the
# reference is dropped, which is what keeps a long-running process's timestamps
# comparable with other processes' on the same host. It never steps the clock
# BACK — a clock that ran ahead of the reference keeps its lead rather than
# repeat time (see _sk_clock_install) — so timestamps stay monotonic and a span
# straddling the call cannot go negative. One that ran behind steps forward.
#
# That offset is scale error times time since the last calibration: the x86_64
# window measures the counter to ~20 ppm (1 sd, Linux), i.e. up to ~0.1 s/hour.
#
# Cost is a range, not a fixed 10 ms. x86_64: the calibration window retries
# until the reference clock actually advances (up to 8 attempts of one nanosleep
# plus two 5-read reference samples each), so this pauses the caller ~10 ms on a
# fine-grained clock and up to ~80 ms on a coarse one. aarch64 reads CNTFRQ_EL0
# (architectural, cannot drift) and only re-anchors: five reference reads, no
# sleep. AGNOS does no calibration at all.
#
# Single-threaded only — sakshi makes no concurrency guarantees, so callers
# must ensure no other thread is in _sk_now_ns / span / trace during the call.
# Recommended cadence for ppm-level accuracy: hourly from a low-priority
# context. x86_64: panics if invariant TSC has somehow disappeared (won't on
# real hardware). aarch64: reads CNTFRQ_EL0 (architectural; cannot drift).
fn sakshi_clock_recalibrate(): i64 {
    _sk_tsc_freq_hz = 0;
    # Clear the attempted-flag too, or _sk_clock_init early-returns and this
    # becomes a silent no-op.
    _sk_clock_init_done = 0;
    _sk_clock_init();
    return _sk_tsc_freq_hz;
}

# Convert a counter reading to nanoseconds on the reference clock's timeline:
#   ((ticks * scale) >> 32) + _sk_tsc_offset
# computed via 64×64→128 multiply + double-precision right shift so the full
# u64 tick range is safe with no native 128-bit math. The offset is the
# calibration anchor, folded (2.5.4) — see its declaration.
fn _sk_ticks_to_ns(ticks): i64 {
    var scale = _sk_tsc_scale;
    var ret: i64 = 0;
    #ifdef CYRIUS_ARCH_X86
    asm {
        # Frame: [rbp-8]=ticks, [rbp-16]=scale, [rbp-24]=ret
        0x48; 0x8B; 0x45; 0xF8;        # mov rax, [rbp-8]    ; ticks
        0x48; 0x8B; 0x4D; 0xF0;        # mov rcx, [rbp-16]   ; scale
        0x48; 0xF7; 0xE1;              # mul rcx              ; rdx:rax = ticks*scale
        0x48; 0x0F; 0xAC; 0xD0; 0x20;  # shrd rax, rdx, 32    ; rax = (rdx:rax) >> 32
        0x48; 0x89; 0x45; 0xE8;        # mov [rbp-24], rax    ; ret
    }
    #endif
    #ifdef CYRIUS_ARCH_AARCH64
    asm {
        # Frame: [x29-8]=ticks, [x29-16]=scale, [x29-24]=ret
        0xA0; 0x83; 0x5F; 0xF8;        # ldur x0, [x29, #-8]   ; ticks
        0xA1; 0x03; 0x5F; 0xF8;        # ldur x1, [x29, #-16]  ; scale
        0x02; 0x7C; 0x01; 0x9B;        # mul   x2, x0, x1      ; low 64 bits of ticks*scale
        0x03; 0x7C; 0xC1; 0x9B;        # umulh x3, x0, x1      ; high 64 bits
        0x64; 0x80; 0xC2; 0x93;        # extr  x4, x3, x2, #32 ; (x3:x2) >> 32
        0xA4; 0x83; 0x1E; 0xF8;        # stur  x4, [x29, #-24] ; ret
    }
    #endif
    return ret + _sk_tsc_offset;
}
