# format.cyr — internal formatting helpers for sakshi
# Zero-dep: inlined string/memory primitives needed by trace and span modules.
# No heap allocation. Fixed buffers only.

# ================================================================
# Primitives
# ================================================================

# Copy n bytes from src to dst (8-byte bulk + byte remainder)
fn _sk_memcpy(dst, src, n): i64 {
    var i: i64 = 0;
    while (i + 8 <= n) {
        store64(dst + i, load64(src + i));
        i = i + 8;
    }
    while (i < n) {
        store8(dst + i, load8(src + i));
        i = i + 1;
    }
    return dst;
}

# Fill n bytes at dst with val
fn _sk_memset(dst, val, n): i64 {
    for (var i = 0; i < n; i = i + 1) {
        store8(dst + i, val);
    }
    return dst;
}

# ================================================================
# Integer formatting
# ================================================================

# Convert integer to decimal string in buffer, return length written.
# Buffer must be at least 24 bytes.
fn _sk_fmt_int(n, buf): i64 {
    var bi = 23;
    var neg: i64 = 0;
    # i64::MIN: `n = 0 - n` is a NO-OP there (two's-complement abs overflows back to
    # itself), so n stayed negative, both the `n == 0` guard and a `n > 0` loop were
    # skipped, and this emitted the sign byte and NOTHING ELSE — length 1, the string
    # "-". Keep the sign FLAG, never negate n, extract digits from the negative value
    # and negate each digit. `!= 0` is the load-bearing half. `/` and `%` truncate
    # toward zero on x86, aarch64 and cx (all three verified).
    # Same defect and same fix as cyrius 6.5.8's lib/fmt.cyr sweep; this is the
    # upstream half of it. sakshi 2.4.8.
    if (n < 0) { neg = 1; }
    if (n == 0) { store8(buf + bi, 48); bi = bi - 1; }
    while (n != 0) {
        var d = n % 10;
        if (d < 0) { d = 0 - d; }
        store8(buf + bi, 48 + d); bi = bi - 1; n = n / 10;
    }
    if (neg == 1) { store8(buf + bi, 45); bi = bi - 1; }
    var len = 23 - bi;
    var src = bi + 1;
    for (var si = 0; si < len; si = si + 1) {
        store8(buf + si, load8(buf + src + si));
    }
    store8(buf + len, 0);
    return len;
}

# ================================================================
# Internal: write an integer into buf at pos, respecting cap. Returns new pos.
#
# NAMING (do not rename back): this was `_sk_write_int` until 2.4.7. In cyrius,
# `X_int` / `X_str` / `X_cstr` are RESERVED overload-dispatch suffixes — the
# compiler rewrites a call `X(a, ...)` into `X_int`/`X_str` when arg 1 matches
# that type and the sibling exists. `_sk_write(buf, len)` (output.cyr) is an
# unrelated flush-to-output fn, so `_sk_write_int` claimed the dispatch slot of a
# function it has nothing to do with: any `_sk_write(someInt, ...)` whose result
# is assigned would have been silently redirected here, a 4-parameter fn, with
# the missing arguments bound to garbage. Latent rather than live only because
# every `_sk_write` call site passes a buffer address as arg 1.
# A suffix-named sibling must be the SAME-arity type variant of its base or not
# carry the suffix at all. See bayan CHANGELOG [1.3.0] for the same defect live.
# ================================================================
fn _sk_buf_write_number(buf, pos, cap, val): i64 {
    var tmp[24];
    var tlen = _sk_fmt_int(val, &tmp);
    var ti = 0;
    while (ti < tlen && pos < cap) {
        store8(buf + pos, load8(&tmp + ti));
        pos = pos + 1;
        ti = ti + 1;
    }
    return pos;
}

# Internal: write a string into buf at pos, respecting cap. Returns new pos.
# Was `_sk_write_str` until 2.4.7 — see the naming note on _sk_buf_write_number
# above; `_str` is a reserved cyrius overload-dispatch suffix and this fn is not
# a type-variant of `_sk_write`.
fn _sk_buf_write_string(buf, pos, cap, s, slen): i64 {
    var wi = 0;
    while (wi < slen && pos < cap) {
        store8(buf + pos, load8(s + wi));
        pos = pos + 1;
        wi = wi + 1;
    }
    return pos;
}

# ================================================================
# Text line formatters (for stderr/file targets)
# ================================================================

# Format a trace line: "[timestamp] [LEVEL] msg\n"
# Returns bytes written. Caller provides timestamp.
fn _sk_fmt_line(buf, cap, ts, level_str, level_len, msg, msg_len): i64 {
    var pos: i64 = 0;

    # [timestamp]
    if (pos < cap) { store8(buf + pos, 91); pos = pos + 1; }
    pos = _sk_buf_write_number(buf, pos, cap, ts);
    if (pos < cap) { store8(buf + pos, 93); pos = pos + 1; }
    if (pos < cap) { store8(buf + pos, 32); pos = pos + 1; }

    # [LEVEL]
    if (pos < cap) { store8(buf + pos, 91); pos = pos + 1; }
    pos = _sk_buf_write_string(buf, pos, cap, level_str, level_len);
    if (pos < cap) { store8(buf + pos, 93); pos = pos + 1; }
    if (pos < cap) { store8(buf + pos, 32); pos = pos + 1; }

    # message
    pos = _sk_buf_write_string(buf, pos, cap, msg, msg_len);

    # newline
    if (pos < cap) { store8(buf + pos, 10); pos = pos + 1; }

    return pos;
}

# Format a span line: "[timestamp] [ACTION] name (elapsed ns)\n"
# Returns bytes written. Caller provides timestamp.
fn _sk_fmt_span(buf, cap, ts, action, action_len, name, name_len, elapsed_ns): i64 {
    var pos: i64 = 0;

    # [timestamp]
    if (pos < cap) { store8(buf + pos, 91); pos = pos + 1; }
    pos = _sk_buf_write_number(buf, pos, cap, ts);
    if (pos < cap) { store8(buf + pos, 93); pos = pos + 1; }
    if (pos < cap) { store8(buf + pos, 32); pos = pos + 1; }

    # [ACTION]
    if (pos < cap) { store8(buf + pos, 91); pos = pos + 1; }
    pos = _sk_buf_write_string(buf, pos, cap, action, action_len);
    if (pos < cap) { store8(buf + pos, 93); pos = pos + 1; }
    if (pos < cap) { store8(buf + pos, 32); pos = pos + 1; }

    # name
    pos = _sk_buf_write_string(buf, pos, cap, name, name_len);

    # elapsed if provided (> 0)
    if (elapsed_ns > 0) {
        if (pos < cap) { store8(buf + pos, 32); pos = pos + 1; }
        if (pos < cap) { store8(buf + pos, 40); pos = pos + 1; }
        pos = _sk_buf_write_number(buf, pos, cap, elapsed_ns);
        # "ns)"
        if (pos < cap) { store8(buf + pos, 110); pos = pos + 1; }
        if (pos < cap) { store8(buf + pos, 115); pos = pos + 1; }
        if (pos < cap) { store8(buf + pos, 41); pos = pos + 1; }
    }

    # newline
    if (pos < cap) { store8(buf + pos, 10); pos = pos + 1; }

    return pos;
}

# ================================================================
# Binary event format (for ring buffer / UDP targets)
# ================================================================
# Layout (12 bytes):
#   [0:7]  timestamp_ns  (u64)  — monotonic nanoseconds
#   [8]    level         (u8)   — log level enum value
#   [9]    category      (u8)   — error category or 0
#   [10:11] msg_len      (u16)  — length of following message bytes
# Followed by msg_len bytes of message data (variable length).
# Total event size: 12 + msg_len

enum _SkBinConst {
    _SK_BIN_HDR_SIZE = 12;
}

# Write a binary event header into buf. Returns header size (12).
fn _sk_bin_write_hdr(buf, timestamp, level, category, msg_len): i64 {
    store64(buf, timestamp);
    store8(buf + 8, level);
    store8(buf + 9, category);
    store16(buf + 10, msg_len);
    return _SK_BIN_HDR_SIZE;
}

# Read a binary event header from buf. Returns fields via out pointers.
# out_ts, out_level, out_cat, out_msg_len are pointers to i64.
fn _sk_bin_read_hdr(buf, out_ts, out_level, out_cat, out_msg_len): i64 {
    store64(out_ts, load64(buf));
    store64(out_level, load8(buf + 8));
    store64(out_cat, load8(buf + 9));
    store64(out_msg_len, load16(buf + 10));
    return _SK_BIN_HDR_SIZE;
}
