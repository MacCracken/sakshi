# span.cyr — enter/exit function tracking with timing
# Uses _sk_now_ns() from clock.cyr for nanosecond precision (cycle-counter backed since v2.2.0).
# Routes through _sk_emit_span: binary for buffer/UDP, text for stderr/file.
# Fixed-depth span stack — no heap allocation.
# Depends: clock.cyr, format.cyr, output.cyr, trace.cyr (included via lib.cyr)
#
# Recommended usage with defer (Cyrius >= 3.2.0):
#
#   fn my_function() {
#       sakshi_span_enter("my_function", 11);
#       defer { sakshi_span_exit(); }
#       # ... function body — span_exit guaranteed on return
#   }

# Span stack — fixed depth of 16.
# Each entry: { name_ptr: i64, name_len: i64, start_ns: i64 } = 24 bytes
# Total: 16 * 24 = 384 bytes
var _sk_span_stack[384];
var _sk_span_depth: i64 = 0;
# Trace id. `_sk_trace_id` is the LOW 64 bits; `_sk_trace_hi` is the HIGH 64
# bits (0 unless a 128-bit id was set). A W3C trace-id is 128-bit, so a
# consumer bridging into distributed tracing keeps the full id via the _128
# API below; the original i64 API is the low half (hi = 0) for back-compat.
var _sk_trace_id: i64 = 0;
var _sk_trace_hi: i64 = 0;
enum _SkSpanConst {
    _SK_MAX_SPANS = 16;
}

# Count of spans refused because the stack was full. Never reset — it is a
# cumulative "how much tracing was lost" figure, not a gauge.
var _sk_spans_dropped: i64 = 0;

# Enter a span — push name + timestamp onto the stack.
# One _sk_now_ns per call: the same reading seeds both the stack start time
# and the emitted event's timestamp.
#
# Returns 0 when the span was pushed, and a NON-ZERO count when it was
# refused because the stack was full.
#
# Saturation used to be completely invisible: this returned 0 either way and
# emitted nothing, so a caller with an unbalanced enter/exit pair burned one
# of the 16 slots permanently (the depth counter is a global and is never
# reset) and after 16 of them ALL span tracing stopped, with no diagnostic
# anywhere. A tracing library that stops tracing has to say so. Reported by
# yukti 2.3.4, which had 18 unbalanced returns across 7 functions and lost
# observability in exactly this way.
#
# The 0-on-success convention is preserved, matching sakshi_log_kv in 2.4.10
# (0 = fully emitted, non-zero = what did not fit). Every existing caller
# ignores the return, so this is additive information, not a break.
#
# The warning is ONE-SHOT — a saturated stack means the next call saturates
# too, and a warning per call would be its own log storm.
fn sakshi_span_enter(name, name_len): i64 {
    # Lower-bound guard. `offset` below is `_sk_span_depth * 24`, and the three
    # store64s write 24 bytes there — so a NEGATIVE depth writes BEFORE
    # _sk_span_stack and corrupts whatever precedes it. The upper bound was
    # already checked; this is the other half of the same buffer contract
    # (every `var buf[N]` access offset must land inside the N bytes we own).
    #
    # A negative depth cannot arise from balanced single-threaded use — exit
    # refuses to go below 0 — so reaching this means either memory corruption
    # or sakshi_span_exit called from two threads at once, which the
    # single-threaded contract forbids but cannot enforce. Recover to a sane
    # stack rather than scribbling outside it.
    if (_sk_span_depth < 0) { _sk_span_depth = 0; }
    if (_sk_span_depth >= _SK_MAX_SPANS) {
        _sk_spans_dropped = _sk_spans_dropped + 1;
        if (_sk_spans_dropped == 1) {
            sakshi_warn("sakshi: span stack full (16) - spans dropped; check for unbalanced sakshi_span_enter", 84);
        }
        return _sk_spans_dropped;
    }
    var ts = _sk_now_ns();
    var offset = _sk_span_depth * 24;
    store64(&_sk_span_stack + offset, name);
    store64(&_sk_span_stack + offset + 8, name_len);
    store64(&_sk_span_stack + offset + 16, ts);
    _sk_span_depth = _sk_span_depth + 1;

    _sk_emit_span(ts, SK_SPAN_ENTER, "ENTER", 5, name, name_len, 0);
    return 0;
}

# Exit the current span — pop, compute elapsed, emit.
# One _sk_now_ns per call: used for both elapsed computation and event ts.
fn sakshi_span_exit(): i64 {
    if (_sk_span_depth <= 0) { return 0; }
    _sk_span_depth = _sk_span_depth - 1;
    var offset = _sk_span_depth * 24;
    var name = load64(&_sk_span_stack + offset);
    var name_len = load64(&_sk_span_stack + offset + 8);
    var start = load64(&_sk_span_stack + offset + 16);
    var ts = _sk_now_ns();
    var elapsed = ts - start;

    _sk_emit_span(ts, SK_SPAN_EXIT, "EXIT", 4, name, name_len, elapsed);
    return elapsed;
}

# Get current span depth
fn sakshi_span_depth(): i64 {
    return _sk_span_depth;
}

# Cumulative count of spans refused because the stack was full.
#
# Deliberately NOT prefixed as public API in the 2.4.x line: it exists so the
# test suite can assert the drop path, and so a consumer debugging lost traces
# can read it. Promoting it to a documented accessor is a MINOR change (new
# public surface) and is left for 2.5.0.
fn _sk_spans_dropped_count(): i64 {
    return _sk_spans_dropped;
}

# Set the active (64-bit) trace ID for correlating spans and events.
# Typically set once at the root span of a request/operation. Clears the high
# half — a 64-bit id is a full id in the low half.
fn sakshi_trace_set(id): i64 {
    _sk_trace_id = id;
    _sk_trace_hi = 0;
    return 0;
}

# Get the active (low 64 bits of the) trace ID. Unchanged for back-compat.
fn sakshi_trace_id(): i64 {
    return _sk_trace_id;
}

# Set a full 128-bit trace ID (e.g. a W3C `traceparent` trace-id): `hi` is the
# high 64 bits, `lo` the low 64. A consumer that adopts an inbound distributed
# trace uses this to preserve the whole id; `sakshi_trace_id()` still returns
# the low half.
fn sakshi_trace_set_128(hi, lo): i64 {
    _sk_trace_hi = hi;
    _sk_trace_id = lo;
    return 0;
}

# High 64 bits of the active trace ID (0 unless a 128-bit id was set).
fn sakshi_trace_id_hi(): i64 {
    return _sk_trace_hi;
}

# Low 64 bits of the active trace ID (== sakshi_trace_id; provided for symmetry
# with sakshi_trace_id_hi).
fn sakshi_trace_id_lo(): i64 {
    return _sk_trace_id;
}
